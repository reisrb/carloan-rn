      "bundleIdentifier": "com.rafaelreis.carloan-rn",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.rafaelreis.carloan_rn"
    },
    "web": {
      "favicon": "./assets/icon-192.png",
      "bundler": "metro",
      "output": "single",
      "name": "CarLoan",
      "shortName": "CarLoan",
      "description": "Gestão de financiamento de veículos",
      "themeColor": "#000000",
      "backgroundColor": "#000000"
    }
  }
}
